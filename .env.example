# CineMind AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="CineMind AI"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database
# Default: SQLite for seamless local development without external service dependencies
DATABASE_URL=sqlite:///./cinemind.db
# PostgreSQL alternative for production:
# DATABASE_URL=postgresql://cinemind:cinemind_secret@localhost:5432/cinemind_db

# ML & NLP Configuration
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
USE_PYSPARK=true
ENABLE_GPU=false

# Hybrid Recommender Weights (Must sum to 1.0)
CONTENT_WEIGHT=0.45
COLLABORATIVE_WEIGHT=0.40
SENTIMENT_WEIGHT=0.15

# Dataset Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
EVALUATION_REPORT_PATH=./data/processed/evaluation_report.json
